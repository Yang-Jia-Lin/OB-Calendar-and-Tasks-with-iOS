{
  "name": "calendar-task-timer-workspace",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "desktop:build": "node Build/desktop-build.mjs",
    "desktop:runtime": "pwsh -NoProfile -File Build/desktop-runtime.ps1",
    "desktop:package": "pwsh -NoProfile -File Build/desktop-package.ps1",
    "desktop:release": "pwsh -NoProfile -File Build/desktop-release.ps1",
    "test:desktop-ui": "npm run desktop:build && node Tests/desktop-ui.mjs",
    "test:desktop-smoke": "npm run desktop:build && node Tests/desktop-smoke.mjs",
    "test:desktop-paths": "node Tests/desktop-paths.mjs",
    "check": "tsc --noEmit",
    "build": "node Build/build.mjs",
    "release": "pwsh -NoProfile -File Build/release.ps1",
    "test": "node Build/test.mjs",
    "preview": "node Preview/server.mjs",
    "test:ui": "node Tests/connector-ui.mjs && node Tests/diary-ui.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "25.9.9",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "playwright": "1.56.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "ical.js": "2.2.1",
    "temporal-polyfill": "1.0.1"
  }
}
