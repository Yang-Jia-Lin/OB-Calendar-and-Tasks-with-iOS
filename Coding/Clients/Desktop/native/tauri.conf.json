{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendar Task Timer",
  "version": "0.1.1",
  "identifier": "com.yangjialin.calendar-task-timer",
  "build": { "frontendDist": "../../../../Agents/Tests/Desktop/ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "日历与计时", "width": 1060, "height": 780, "minWidth": 720, "minHeight": 500, "visible": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": { "../../../../Agents/Tests/Desktop/resources/": "resources/" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }, "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] } }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["ctt-desktop"] } } }
}
